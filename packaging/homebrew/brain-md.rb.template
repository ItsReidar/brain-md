cask "brain-md" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/ItsReidar/brain-md/releases/download/v#{version}/brain-md-#{version}.dmg"
  name "Brain.md"
  desc "Markdown notes editor with live preview and a built-in MCP server"
