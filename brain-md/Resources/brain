#!/bin/sh
# Opens Markdown files in Brain.md from the terminal: brain [file ...]
# Homebrew links this as `brain`; files inside the vault open as their note.
if [ $# -eq 0 ]; then
    exec open -b itsreidar.brain-md
fi
# Missing files are created empty, so `brain new.md` starts a new note. The attribute tells
# Brain.md to trash the file if it's closed without anything written to it.
for file in "$@"; do
    if [ ! -e "$file" ]; then
        : > "$file" || exit 1
        xattr -w itsreidar.brain-md.new 1 "$file"
    fi
done
exec open -b itsreidar.brain-md -- "$@"
