# Test Coverage & LLVM Profiling
# ==========================================
*.profraw
*.profdata
*.coverage
*.xccovreport
*.xccovarchive
*.gcno
*.gcda

# ==========================================
# Swift Package Manager
# ==========================================
.build/
.swiftpm/
Packages/

# ==========================================
# Tooling & Build Servers (SweetPad / SourceKit-LSP)
# ==========================================
# Build Server Protocol configuration containing machine-specific paths
buildServer.json

# ==========================================
