# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# iCloud generated files
*.icloud

# ==========================================
# AI Generated Code
# ==========================================
.agent
.agents
.claude

# ==========================================
# Xcode & Swift Build Artifacts
# ==========================================
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

